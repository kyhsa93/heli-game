{
  "name": "heli-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc && vitest run && vite build",
    "battle:map": "node --experimental-transform-types --no-warnings --import ./scripts/lib/ts.mjs scripts/battle-map-gen.ts",
    "battle:bench": "node --experimental-transform-types --no-warnings --import ./scripts/lib/ts.mjs scripts/battle-bench.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
